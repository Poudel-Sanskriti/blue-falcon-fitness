# Copy this file to .env and replace every placeholder before starting the API.
# Never commit the resulting .env file.

PROJECT_NAME=Blue Falcon Fitness
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ADMIN_PASSWORD=replace-with-a-strong-admin-password
PREMIUM_COUPON=replace-with-a-private-coupon-code

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_AUTH=0
REDIS_DB_LLM=1
REDIS_DB_QUEUE=2

ENABLE_LLM_MODEL=false
LOCAL_MODEL_NAME=llama3
OLLAMA_HOST=http://localhost:11434
